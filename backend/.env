# Database URL for SQLx
DATABASE_URL="mysql://mosip_user:mosip_password@localhost:3306/mosip_mvp_dev"

# Secret key for JWT encoding and decoding
# Generate a strong, random string for this in your actual .env file
# Example: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-please-change-me"

# Log level for the application
# Example: backend=debug,tower_http=debug,sqlx=warn
RUST_LOG="info,sqlx=warn"

# Port for the backend server to listen on
PORT="8000"

# Default Admin User credentials for seeding (if applicable via a script)
# These are typically used by a seeding script, not directly by the app runtime after initial setup.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="adminpassword"
